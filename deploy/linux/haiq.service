[Unit]
Description=haiqbot —— 协议无关的 QQ Bot 框架
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haiqbot
Group=haiqbot

# 仓库路径按实际修改
WorkingDirectory=/opt/haiqbot
Environment=PYTHONUNBUFFERED=1
Environment=HAIQ_DATA_DIR=/var/lib/haiqbot
Environment=HAIQ_SECRETS_DIR=/etc/haiqbot/secrets

# 凭据通过 EnvironmentFile 注入（chmod 600，属主 haiqbot）
EnvironmentFile=-/etc/haiqbot/haiqbot.env

ExecStart=/opt/haiqbot/.venv/bin/haiq run
Restart=on-failure
RestartSec=5

# 加固：只允许写自己的数据目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/haiqbot
StateDirectory=haiqbot

[Install]
WantedBy=multi-user.target
