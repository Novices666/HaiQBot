# haiqbot 环境变量示例 —— 复制为 .env 并填入真实值，或者用 `haiq vault set <NAME>` 写入加密库。
# 注意：.env 已在 .gitignore 中，但加密 vault 更安全（DPAPI 绑定当前用户）。

# ---- 生图 provider（OpenAI 兼容） ----
WEFT_IMAGE_API_KEY=
# WEFT_IMAGE_BASE_URL=https://api.example.com/v1
# WEFT_IMAGE_MODEL=gpt-image-1

# ---- QQ 官方平台 ----
# WEFT_QQ_APP_ID=
# WEFT_QQ_APP_SECRET=

# ---- OneBot v11 ----
# WEFT_ONEBOT_ACCESS_TOKEN=

# ---- vault 密码（enc = "aead" 时必需；仅 docker compose 会自动读 .env）----
# WEFT_VAULT_PASSPHRASE=
